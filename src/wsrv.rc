#include <winver.h>
#include "resource.h"

// Admin UI, embedded so the executable is self-contained.
IDR_ADMIN_HTML RCDATA "../admin-ui/index.html"
IDR_ADMIN_JS   RCDATA "../admin-ui/app.js"
IDR_ADMIN_CSS  RCDATA "../admin-ui/app.css"
IDR_ADMIN_ICON RCDATA "../admin-ui/favicon.svg"

// Event Log message table (generated by mc.exe).
#include "messages.rc"

1 RT_MANIFEST "wsrv.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Andrew Rigney"
            VALUE "FileDescription", "wsrv lightweight HTTPS / HTTP/3 web server"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "wsrv"
            VALUE "LegalCopyright", "Copyright (c) 2026 Andrew Rigney. MIT License."
            VALUE "OriginalFilename", "wsrv.exe"
            VALUE "ProductName", "wsrv"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
